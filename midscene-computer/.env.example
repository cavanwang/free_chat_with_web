# Midscene 模型配置
# 复制此文件为 .env,然后填入你的 API Key
# 当前默认使用千问 DashScope(已预填默认 Key)

# ============ 选项 A: 阿里千问 (DashScope) ← 默认启用 ============
# 申请地址: https://dashscope.console.aliyun.com/
MIDSCENE_MODEL_API_KEY=sk-8954849762d04e20875f963035ed25f6
MIDSCENE_MODEL_NAME=qwen3.7-plus
MIDSCENE_MODEL_FAMILY=qwen3
MIDSCENE_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ============ 选项 B: 豆包 Seed (火山引擎) ============
# 申请地址: https://console.volcengine.com/ark/
# MIDSCENE_MODEL_API_KEY=your-volcengine-api-key
# MIDSCENE_MODEL_NAME=doubao-seed-2.1-turbo
# MIDSCENE_MODEL_FAMILY=doubao-seed
# MIDSCENE_MODEL_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ============ 选项 C: 通用 (OpenAI) ============
# MIDSCENE_MODEL_API_KEY=your-openai-api-key
# MIDSCENE_MODEL_NAME=gpt-4o
# MIDSCENE_MODEL_FAMILY=openai
# MIDSCENE_MODEL_BASE_URL=https://api.openai.com/v1

# ============ 服务端口(可选) ============
MIDSCENE_PORT=3456